# =========================================================================
# Drop Builder — variables de entorno
# Copia este archivo a .env.local y rellena los valores.
# NUNCA commitees .env.local ni credenciales reales (ver .gitignore).
# =========================================================================

# --- Base de datos (Neon / Postgres serverless) ---
# Si NO está definida, la plataforma arranca en MODO MOCK con datos de ejemplo
# generados en memoria. Esto permite desarrollar sin DB.
# Cuando tengas Neon: pega aquí la connection string (con sslmode=require).
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Endpoint de ingestión (Base44 -> Drop Builder) ---
# Token compartido que Base44 debe enviar en la cabecera `x-ingest-token`
# para que aceptemos el webhook/POST. Genera uno largo y aleatorio.
# INGEST_TOKEN="cambia-esto-por-un-token-largo-y-secreto"

# --- Base44 (se rellena cuando Gonzalo facilite credenciales/API docs) ---
# BASE44_API_BASE=""
# BASE44_API_KEY=""

# --- Alertas (opcional, fase 4) ---
# Webhook de Telegram/Slack para notificar alertas. Opcional.
# ALERT_WEBHOOK_URL=""

# --- Protección del cron de Vercel ---
# Vercel envía esta cabecera en los cron jobs; la usamos para autorizar.
# CRON_SECRET="cambia-esto"
