{
  "name": "drop-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de métricas y stats tipo holding para tiendas de e-commerce (Drop Builder). Ingesta datos desde Base44 y los consolida en Neon.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "test": "node --experimental-strip-types --test lib/*.test.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "next": "^15.5.19",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
